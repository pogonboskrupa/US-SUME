<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ic_launcher_background" />
        </shape>
    </item>
    <item android:width="53dp" android:height="53dp" android:gravity="center"
        android:left="-2.5dp" android:top="-2.5dp"
        android:right="-2.5dp" android:bottom="-2.5dp">
        <bitmap android:src="@mipmap/ic_launcher_foreground"
            android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
